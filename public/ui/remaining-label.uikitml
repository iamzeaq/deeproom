<!-- Small remaining-time readout under the orb during a session. Scale 0.1. -->
<style>
  .root {
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 14px;
    background-color: #17181c;
  }

  .clock {
    color: #f3e6d0;
    font-size: 16px;
    font-weight: 700;
  }
</style>
<div class="root">
  <span id="remaining-text" class="clock">25:00</span>
</div>
